+  subsets: ["latin"],
+  weight: ["400", "500"],
+  variable: "--sabi-font-mono",
+  display: "swap",
+});
+
 export const metadata: Metadata = {
   // `absolute` so the brand name isn't repeated by the "%s | Sabi" template.
   title: {
@@ -60,7 +82,7 @@ export default function SabiLayout({ children }: { children: React.ReactNode })
