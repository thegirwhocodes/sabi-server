+  border: 1.5px solid var(--sabi-ink);
+  border-radius: 20px;
+  box-shadow: 10px 10px 0 var(--sabi-ink);
+}
+
+.sabi-quote-mark {
+  font-family: var(--sabi-font-display), ui-sans-serif, sans-serif;
+  font-weight: 800;
+  font-size: 5rem;
+  line-height: 0.6;
+}
+
+/* Principles */
+.sabi-principle {
+  border-top: 1.5px solid var(--sabi-ink);
+  padding-top: 1.25rem;
+}
+
+.sabi-principle-title {
+  font-family: var(--sabi-font-display), ui-sans-serif, sans-serif;
+  font-weight: 700;
+  font-size: clamp(1.9rem, 3vw, 2.6rem);
+  letter-spacing: -0.035em;
+  line-height: 1;
+}
+
+/* Developer callout */
+.sabi-dev-callout {
+  background: var(--sabi-ink);
+  color: #fff;
+  border-radius: 24px;
+  overflow: hidden;
+}
+
+.sabi-dev-code {
+  font-family: var(--sabi-font-mono), ui-monospace, monospace;
+  font-size: 13px;
+  line-height: 1.7;
+  color: #c9cec8;
+  background: #161d19;
+  border: 1px solid var(--sabi-admin-line);
+  border-radius: 14px;
+}
+
+.sabi-dev-code .tok-k {
+  color: var(--sabi-yellow);
+}
+
+.sabi-dev-code .tok-s {
+  color: #8fd6bd;
+}
+
+.sabi-dev-code .tok-c {
+  color: #6b746d;
+}
+
+/* FAQ */
+.sabi-faq details {
+  border-top: 1px solid var(--sabi-border-strong);
+}
+
+.sabi-faq details:last-child {
+  border-bottom: 1px solid var(--sabi-border-strong);
+}
+
+.sabi-faq summary {
+  list-style: none;
+  cursor: pointer;
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  gap: 1.5rem;
+  padding: 1.35rem 0;
+  font-family: var(--sabi-font-display), ui-sans-serif, sans-serif;
+  font-weight: 600;
+  font-size: 1.25rem;
+  letter-spacing: -0.015em;
+}
+
+.sabi-faq summary::-webkit-details-marker {
+  display: none;
+}
+
+.sabi-faq-toggle {
+  flex: 0 0 auto;
+  width: 2rem;
+  height: 2rem;
+  border-radius: 999px;
+  border: 1.5px solid var(--sabi-ink);
+  position: relative;
+  transition:
+    background 0.15s ease,
+    transform 0.2s ease;
+}
+
+.sabi-faq-toggle::before,
+.sabi-faq-toggle::after {
+  content: "";
+  position: absolute;
+  left: 50%;
+  top: 50%;
+  width: 11px;
+  height: 1.5px;
+  background: currentColor;
+  transform: translate(-50%, -50%);
+}
+
+.sabi-faq-toggle::after {
+  transform: translate(-50%, -50%) rotate(90deg);
+}
+
+.sabi-faq details[open] .sabi-faq-toggle {
+  background: var(--sabi-yellow);
+  transform: rotate(45deg);
+}
+
+.sabi-faq summary:hover .sabi-faq-toggle {
+  background: var(--sabi-yellow);
+}
+
+.sabi-final-cta {
+  background: var(--sabi-yellow);
+  border-top: 1.5px solid var(--sabi-ink);
+  position: relative;
+  overflow: hidden;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .sabi-shell *,
+  .sabi-shell *::before,
+  .sabi-shell *::after {
+    animation: none !important;
+    transition: none !important;
+  }
+
+  .sabi-reveal {
+    opacity: 1;
+    transform: none;
+  }
 }
