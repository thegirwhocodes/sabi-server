# =============================================================
# Sabi Voice AI Server — Environment Variables
# Copy this to .env and fill in your values:
#   cp .env.example .env
#   nano .env
# =============================================================

# Supabase (same instance as curriculum-app)
# Find these at: Supabase Dashboard > Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Claude Haiku API (primary LLM — highest quality)
# Get from: console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-api-key

# YarnGPT TTS (Nigerian voices)
# Get from: yarngpt.ai
YARNGPT_API_KEY=your-yarngpt-api-key

# Ollama LLM (fallback — used only if ANTHROPIC_API_KEY not set)
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b-instruct-q4_K_M

# Your server's public URL (the setup script replaces this automatically)
# Must match the domain in your DNS A record and nginx.conf
SERVER_URL=https://sabi.yourdomain.com

# Africa's Talking (get these from africastalking.com dashboard)
# Use "sandbox" for AT_USERNAME during testing
AT_USERNAME=sandbox
AT_API_KEY=your-africas-talking-api-key

# API key for authenticating requests to /stt, /tts, /llm, /process-turn
# Generate with: python3 -c "import secrets; print('sabi_' + secrets.token_urlsafe(32))"
# If empty, authentication is disabled (not recommended in production)
SABI_API_KEY=your-api-key
