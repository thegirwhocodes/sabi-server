# =============================================================
# Sabi Voice AI Server — Environment Variables
# Copy this to .env and fill in your values:
#   cp .env.example .env
#   nano .env
# =============================================================

# Supabase (same instance as curriculum-app)
# Find these at: Supabase Dashboard > Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── LLM providers (priority: Cerebras → Claude → Groq → Ollama) ──

# Cerebras: ~2100 tok/s — fastest. Voice response in ~0.1s.
# Get from: cloud.cerebras.ai
CEREBRAS_API_KEY=

# Claude Haiku (fallback LLM — highest quality, ~1s)
# Get from: console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-api-key

# Groq: both LLM fallback AND Whisper STT (28,800 sec/day free)
# Get from: console.groq.com
GROQ_API_KEY=

# Speech-to-text provider controls
# Use SABI_STT_PROVIDER=local with these knobs for local audio-matrix probes.
# CPU smoke: SABI_LOCAL_WHISPER_DEVICE=cpu and SABI_LOCAL_WHISPER_MODEL_SIZE=small or medium.
# Production GPU default remains cuda + large-v3 when these are unset.
SABI_STT_PROVIDER=auto
SABI_LITERACY_STT_PROVIDER=auto
# Gemini 3.5 Flash-Lite multimodal audio canary. `gemini` and `gemini_first`
# are strict: a timeout/error becomes an unclear-audio retry, never a different
# STT model. Use `gemini_fallback` only when provider fallback is intentional.
GEMINI_API_KEY=
SABI_GEMINI_STT_MODEL=gemini-3.5-flash-lite
SABI_GEMINI_STT_BYPASS_VAD=1
SABI_GEMINI_STT_TIMEOUT=5.5
SABI_GEMINI_STT_MAX_TOKENS=64
SABI_GEMINI_STT_THINKING_LEVEL=minimal
SABI_GEMINI_STT_GLOBAL_PROMPT=A Nigerian child on a noisy 8kHz phone call
# curriculum = literal transcription plus a safe course/topic label derived
# from the current curriculum turn. lesson_exact remains available only for
# explicit AI Studio reproduction tests.
SABI_GEMINI_STT_PROMPT_MODE=curriculum
SABI_GEMINI_STT_LESSON_PROMPT=A Nigerian child on a noisy 8kHz phone call is saying their name, introducing themselves and walking through a numeracy lesson. Reply with their responses
# Isolated AudioSocket lane (currently named intron in endpoints for backwards compatibility).
SABI_STT_TEST_PROVIDER=gemini_first
# Names and numeracy stay on Gemini; phoneme/word literacy uses the much
# faster Groq Whisper lane selected by `auto` after the real-call bake-off.
SABI_LITERACY_STT_TEST_PROVIDER=auto
# Optional comma-separated E.164 callers kept on numeracy without changing
# course routing for anyone else. Literacy progress is preserved, not deleted.
SABI_NUMERACY_ONLY_PHONES=
# Gemini Live is the default phone system for every caller, including unknown
# caller IDs. Exclusions immediately use the preserved turn-based pipeline.
# Set ALL=0 for the fast global rollback; in that mode only PHONES uses Live,
# and an empty PHONES value sends every caller to the old pipeline.
SABI_GEMINI_LIVE_ALL=1
SABI_GEMINI_LIVE_EXCLUDE_PHONES=
SABI_GEMINI_LIVE_PHONES=
SABI_LOCAL_WHISPER_MODEL_SIZE=large-v3
SABI_LOCAL_WHISPER_DEVICE=cuda
# Server-side DeepFilterNet v3. Leave off until raw-vs-cleaned gold evaluation
# shows no name/number regressions; failures are fail-open and use raw audio.
SABI_STT_DENOISE=0
SABI_STT_DENOISE_BACKEND=deepfilternet
SABI_STT_DENOISE_POSTFILTER=0
# Local Mac harness alternative: SABI_STT_PROVIDER=whisper_cli uses Homebrew openai-whisper.
SABI_WHISPER_CLI_PATH=whisper
SABI_WHISPER_CLI_MODEL=tiny.en
SABI_WHISPER_CLI_DEVICE=cpu
SABI_WHISPER_CLI_TIMEOUT_SECONDS=120
SABI_WHISPER_CLI_THREADS=2
# Keep off by default for the noisy fake-child matrix; prompt bias can hide raw STT weaknesses.
SABI_WHISPER_CLI_INITIAL_PROMPT=0

# Ollama (last-resort LLM — fully offline)
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b-instruct-q4_K_M

# YarnGPT TTS (Nigerian voices)
# Get from: yarngpt.ai
YARNGPT_API_KEY=your-yarngpt-api-key
SABI_TTS_PRIMARY=elevenlabs
SABI_YARNGPT_VOICE=wura

# Public AudioSocket lane (port 9020): the preserved turn-based fallback uses
# only the healthy self-hosted Naomi voice. Do not silently fall through to a
# lapsed ElevenLabs account or a timing-out YarnGPT endpoint.
SABI_TTS_TEST_PRIMARY=chatterbox_only
SABI_CHATTERBOX_URL=http://chatterbox:8001/tts
SABI_CHATTERBOX_SPEAKER=naomi

# Your server's public URL (the setup script replaces this automatically)
# Must match the domain in your DNS A record and nginx.conf
SERVER_URL=https://sabi.yourdomain.com

# Africa's Talking (get these from africastalking.com dashboard)
# Use "sandbox" for AT_USERNAME during testing
AT_USERNAME=sandbox
AT_API_KEY=your-africas-talking-api-key

# Twilio test path (store TWILIO_AUTH_TOKEN as a Docker secret in production)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+17153122345

# ElevenLabs fallback for the Twilio path (store both as Docker secrets in production)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# API key for authenticating requests to /stt, /tts, /llm, /process-turn
# Generate with: python3 -c "import secrets; print('sabi_' + secrets.token_urlsafe(32))"
# If empty, authentication is disabled (not recommended in production)
SABI_API_KEY=your-api-key

# Asterisk flash-callback tuning
# `twilio` is the production carrier; switch back to `africastalking` for the
# preserved Nigerian SIP route without changing the realtime lesson pipeline.
SABI_SIP_PROVIDER=twilio
SABI_CALLER_ID=+17153122345
FLASH_CALLBACK_DELAY_SECONDS=0
FLASH_CALLBACK_RETRY_DELAY_SECONDS=6
FLASH_CALLBACK_MAX_ATTEMPTS=1
FLASH_CALLBACK_COOLDOWN_SECONDS=20
# Keep retries off by default so voicemail/carrier audio cannot trigger
# repeated callback attempts during direct testing.
FLASH_CALLBACK_RETRY_ENABLED=0

# Realtime AudioSocket UX tuning
# Keep public barge-in disabled until recorded-call validation passes. When it
# is enabled, energy only opens a candidate; Silero speech evidence plus echo
# rejection must approve the interruption before playback stops.
SABI_BARGE_IN_ENABLED=0
# Twilio enters the isolated 9020 listener, so learned barge-in can be tested
# there while 9019 remains on the conservative global default.
SABI_TEST_BARGE_IN_ENABLED=1
SABI_BARGE_RMS=650
SABI_BARGE_START_FRAMES=2
SABI_TURN_GATE_ENABLED=1
SABI_INTERRUPTION_PREFILTER_RMS=180
SABI_INTERRUPTION_VAD_ONSET=0.68
SABI_INTERRUPTION_MIN_SPEECH_MS=320
SABI_INTERRUPTION_MIN_AUDIO_MS=420
SABI_INTERRUPTION_ECHO_THRESHOLD=0.62
SABI_INTERRUPTION_EVAL_INTERVAL_MS=160
SABI_INTERRUPTION_CANDIDATE_RESET_MS=420
# Post-prompt listening is intentionally permissive so one phoneme survives.
SABI_LISTENING_VAD_ONSET=0.38
SABI_LISTENING_MIN_SPEECH_MS=192
# Audio-native semantic/prosodic endpointing. The model is pinned in Dockerfile.
SABI_SMART_TURN_ENABLED=1
SABI_SMART_TURN_COMPLETE_THRESHOLD=0.50
SABI_SMART_TURN_MIN_AUDIO_MS=650
SABI_SMART_TURN_MAX_EXTENSION_MS=2400
SABI_SMART_TURN_MODEL=/app/models/smart-turn-v3.2-cpu.onnx
SABI_UTTERANCE_END_SILENCE_FRAMES=18
SABI_COLLECT_TIMEOUT_MS=80
SABI_MIN_USABLE_CONFIDENCE=0.18
SABI_MAX_UNCLEAR_RETRIES=2
SABI_RETRY_TEXT=I didn't quite hear that. Can you say it again?
SABI_UNCLEAR_AUDIO_RETRY_TEXT=I still can't hear clearly. Please move the phone closer to your mouth, find a quieter spot if you can, and say just the answer slowly.
SABI_KEYPAD_NUMERIC_FALLBACK_ENABLED=1
SABI_KEYPAD_NUMERIC_TIMEOUT_SECONDS=8
SABI_KEYPAD_NUMERIC_MAX_DIGITS=4
SABI_KEYPAD_NUMERIC_INTERDIGIT_SECONDS=1.2
SABI_KEYPAD_NUMERIC_TERMINATORS=hash_star
SABI_KEYPAD_NUMERIC_FALLBACK_TEXT=The phone is still noisy. For this number answer, you can press the digits on your keypad, then press hash.
SABI_KEYPAD_NUMERIC_ANNOUNCEMENT_TEXT=If I ever mishear a number, you can type it on your keypad and press hash.
SABI_ORIGINAL_AUDIOSOCKET_PORT=9021
SABI_ORIGINAL_TTS_PRIMARY=elevenlabs
# Optional comma-separated public IPs allowed to view /admin read-only without
# putting a PIN in the URL. POST/write actions still require SABI_API_KEY.
SABI_ADMIN_TRUSTED_IPS=

# --- Numeric STT sidecar (Gemini Live, SHADOW ONLY) -------------------------
# Groq Whisper + local faster-whisper re-listen to each finished numeric turn on
# the Gemini Live lane. Measurement only: it cannot change Sabi's reply, grade
# or timing. Phase 3 (grading on consensus) stays off until the labelled
# Nigerian PSTN bake-off clears the precision gate in
# docs/PARALLEL_STT_FOR_GEMINI_LIVE_RESEARCH_2026-08-07.md.
SABI_NUMERIC_SIDECAR_ENABLED=1
# Only `shadow` is implemented; any other value logs a warning and stays shadow.
SABI_NUMERIC_SIDECAR_MODE=shadow
# Live-decision deadline the shadow run is scored against (research: 1.2-1.5s).
SABI_NUMERIC_SIDECAR_DEADLINE_SECONDS=1.5
# Shadow collection may exceed the deadline so CPU Whisper latency is measurable.
SABI_NUMERIC_SIDECAR_COLLECTION_TIMEOUT_SECONDS=30
SABI_NUMERIC_SIDECAR_WORKERS=2
SABI_NUMERIC_SIDECAR_MAX_PENDING=4
SABI_NUMERIC_SIDECAR_DRAIN_SECONDS=20
# Defaults to <SABI_SHARED_AUDIO_DIR>/numeric_sidecar/<call_uuid>.jsonl
SABI_NUMERIC_SIDECAR_DIR=
SABI_SIDECAR_GROQ_MODEL=whisper-large-v3
SABI_SIDECAR_GROQ_TIMEOUT_SECONDS=10
SABI_SIDECAR_LOCAL_BEAM_SIZE=5
# Leave EMPTY. A vote must never see the question, operands or expected answer;
# adopt a fixed generic prompt only if bake-off data shows it helps.
SABI_SIDECAR_GENERIC_PROMPT=
# Second sidecar vote. `auto` = Azure when AZURE_SPEECH_KEY/REGION are present
# (gold-clip bake-off 11 Aug 2026: Azure 4/7 @0.71s vs local Whisper 2/7 @11s),
# otherwise the offline engine. Force with `azure` or `local_whisper`.
SABI_NUMERIC_SIDECAR_SECOND_ENGINE=auto
SABI_AZURE_SPEECH_LANGUAGE=en-NG
SABI_AZURE_SPEECH_TIMEOUT_SECONDS=10
